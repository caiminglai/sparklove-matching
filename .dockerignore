# 排除 Windows 下安装的依赖，避免覆盖容器内 npm install 的 Linux 原生模块
# （bcrypt 的 build/Release/*.node 是 win32 格式，进 Linux 容器会加载失败）
backend/node_modules
backend/npm-debug.log
# 密钥不进镜像层：运行时由 compose 的只读 bind mount 提供 /app/.env
backend/.env
backend/.env.production

# 前端：宿主机依赖与构建产物不进镜像（前端在 Docker 内用 npm ci 重新构建）
app/node_modules
app/dist

# 用户上传件不进镜像：运行时读的是挂载点 /uploads（server.js:181 从 /app 向上跳两级），
# 镜像里那份 COPY 进来的副本既用不上，又把真实凭证图留在了镜像层
backend/uploads

# 废弃的历史文件，不进镜像
data/*.db
data/*.db-wal
data/*.db-shm
.git
