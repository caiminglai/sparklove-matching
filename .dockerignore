# 排除 Windows 下安装的依赖，避免覆盖容器内 npm install 的 Linux 原生模块
# （deasync 的 build/Release/*.node 是 win32 格式，进 Linux 容器会加载失败）
backend/node_modules
backend/npm-debug.log
backend/.env.production

# 前端：宿主机依赖与构建产物不进镜像（前端在 Docker 内用 npm ci 重新构建）
app/node_modules
app/dist

# 废弃的历史文件，不进镜像
data/*.db
data/*.db-wal
data/*.db-shm
.git
