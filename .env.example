# ===== 精准匹配 - 环境变量配置模板 =====
# 复制此文件为 .env 并填写实际值

# 服务端口
PORT=8080

# 前端地址(用于 CORS 白名单,多个用逗号分隔)
FRONTEND_URL=http://localhost:4000,http://localhost:4001

# 服务端地址(用于 CORS,生产环境填服务器IP或域名)
SERVER_ORIGIN=http://localhost:8080

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here
# 管理员白名单用户名（逗号分隔，可选）
ADMIN_WHITELIST=

# Token 签名密钥（生产环境必填，强随机字符串）
TOKEN_SECRET=your_token_secret_here
# AES-256 加密密钥（64 位 hex，生产环境必填）
ENCRYPTION_KEY=your-32-byte-hex-key-here
# bcrypt 加密轮数（默认 10，越大越慢越安全）
BCRYPT_ROUNDS=10
# 滑动验证码签名密钥（生产环境必填）
CAPTCHA_SECRET=your_captcha_secret_here

# PostgreSQL 数据库配置
PG_USER=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=match_db
PG_PASSWORD=your-postgres-password-here

# 收款标价兜底默认值（元）
# 只在后台「价格设置」从没改过该项时生效；改过之后以库里 admin_settings 为准。
# 日常改价请在后台页面改，不用改这里、也不用重新部署。
DEPOSIT_AMOUNT=29.9
CONTACT_UNLOCK_AMOUNT=9.9

# Embedding API 配置(可选,用于生成用户画像向量)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-ada-002
