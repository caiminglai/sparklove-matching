# ============================================================
# 精准匹配 - Git 忽略规则
# ============================================================

# ===== 依赖 =====
node_modules/
node-modules-temp/

# ===== 环境变量 =====
.env
.env.*
!.env.example

# ===== 构建输出 =====
dist/
build/
*.tsbuildinfo

# ===== 数据库 =====
data/*
!data/reset_sequences.sql
*.db
*.db-shm
*.db-wal
*.db-journal

# ===== 上传文件 =====
uploads/

# ===== 收款二维码(已提交到仓库,用于接受捐赠)=====
# app/public/
# public/

# ===== 日志 =====
*.log
logs/
npm-debug.log*

# ===== 缓存 =====
.cache/
.eslintcache
.vite/
coverage/
.continue/
.crossnote/

# ===== 图片(测试图片不提交,收款码例外)=====
*.jpg
*.png
*.jpeg
*.gif
*.webp
# 保留收款码图片(生产资源,server.js 会读取 app/public/ 下的图片)
!app/public/wechat-qr.png
!app/public/alipay-qr.png
# README portfolio screenshots (needed for GitHub rendering)
!docs/images/*.png

# ===== 文档(不提交)=====
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# ===== 编辑器/IDE =====
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ===== 压缩包 =====
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# ===== 临时文件 =====
*.tmp
*.bak
*.old
# 回归验证用的临时请求体目录(内含明文测试口令,阶段 8 的 git add -A 会误提交)
tmp_test/

# ===== AI工具配置 =====
CLAUDE.md
