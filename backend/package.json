{
  "name": "match-backend",
  "version": "1.1.0",
  "description": "精准匹配平台后端服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "test:spec": "node --test --test-force-exit --test-reporter=spec \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.8.4",
    "supertest": "^7.3.1"
  }
}
