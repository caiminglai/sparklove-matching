# ===== 精准匹配 - 环境变量配置 =====
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=8080

# 前端地址（用于 CORS 白名单）
FRONTEND_URL=http://localhost:4000

# 服务端地址（用于 CORS）
SERVER_ORIGIN=http://your_server_ip

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
# 管理员白名单用户名（逗号分隔，可选）
ADMIN_WHITELIST=

# Token 签名密钥（生产环境必填，强随机字符串）
TOKEN_SECRET=your_token_secret_here
# AES-256 加密密钥（64 位 hex，生产环境必填）
ENCRYPTION_KEY=your_aes_256_encryption_key_here
# bcrypt 加密轮数（默认 10，越大越慢越安全）
BCRYPT_ROUNDS=10
# 滑动验证码签名密钥（生产环境必填）
CAPTCHA_SECRET=your_captcha_secret_here

# PostgreSQL 数据库配置
PG_USER=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=match_db
PG_PASSWORD=your_pg_password_here

# 充值金额（元）
DEPOSIT_AMOUNT=29.9

# Embedding API 配置
# 模式：mock=本地伪向量（开发用）| openai=OpenAI官方API | custom=自定义API
EMBEDDING_PROVIDER=mock
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-ada-002

# 短信服务配置（预留）
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# 支付配置（微信支付 v3 Native 扫码 + 支付宝）
# 回调地址只能填下面这两个值，不要加 /jzxr 前缀：
# 加了前缀会被前端单页应用兜底成 200 的 index.html，微信以为已送达就不再重推，
# 结果是用户钱扣了、保证金不解锁，而且全程没有任何报错。
# 某个渠道的键没填全，该渠道就不可用：生产环境下 /api/payment/create 会直接返回"配置不完整"
WECHAT_APP_ID=
WECHAT_MCH_ID=
# APIv3 密钥：商户平台「API安全」里设置的 32 位字符串，不是后台的 API 密钥
WECHAT_API_V3_KEY=
# 商户 API 证书序列号（32 位十六进制），与下面这把私钥是同一张证书
WECHAT_MERCHANT_SERIAL_NO=
# apiclient_key.pem 的内容。单行填写时可写成 base64 或把换行替换成 \n，代码会自动还原
WECHAT_MERCHANT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=https://sparklove.cn/api/payment/notify-wechat

ALIPAY_APP_ID=
# 应用私钥（RSA2）。填写方式同上
ALIPAY_PRIVATE_KEY=
# 注意是「支付宝公钥」，不是「应用公钥」，填错会一直签名验证失败
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://sparklove.cn/api/payment/notify-alipay
# 支付完成后浏览器跳回本站的地址
ALIPAY_RETURN_URL=https://sparklove.cn/deposit
